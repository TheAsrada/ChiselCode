{
  "$schema": "https://biomejs.dev/schemas/2.1.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/verify-release-ci.ts",
      "scripts/check-docs.ts",
      "scripts/test-fast.ts",
      "tests/**",
      "evals/**",
      "!evals/fixtures/**",
      "!evals/baselines/**",
      "!evals/results/**"
    ]
  }
}
