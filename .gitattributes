* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# OpenTUI char frames preserve terminal-cell padding, including blank columns.
docs/assets/btw/*.txt whitespace=-blank-at-eol

docs/assets/worktrees/*.txt whitespace=-blank-at-eol,-blank-at-eof
docs/assets/subagents/*.txt whitespace=-blank-at-eol,-blank-at-eof
docs/assets/background-tasks/*.txt whitespace=-blank-at-eol,-blank-at-eof
docs/assets/sidebar/*.txt whitespace=-blank-at-eol,-blank-at-eof
docs/assets/external-extensions/**/*.txt whitespace=-blank-at-eol,-blank-at-eof

docs/assets/extension-themes/**/*.txt whitespace=-blank-at-eol,-blank-at-eof
