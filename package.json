{
  "name": "chiselcode",
  "version": "0.6.37",
  "description": "A secure multi-provider coding agent CLI",
  "type": "module",
  "bin": {
    "chisel": "./dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.gz",
    "dist/*.scm",
    "dist/*.wasm",
    "dist/extension-sdk/*.js",
    "dist/extension-sdk/*.d.ts",
    "dist/desktop-sdk/**/*.js",
    "dist/desktop-sdk/**/*.d.ts",
    "skills/bundled/*/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    "./desktop-sdk": {
      "types": "./dist/desktop-sdk/index.d.ts",
      "import": "./dist/desktop-sdk/index.js"
    },
    "./extension-sdk": {
      "types": "./dist/extension-sdk/index.d.ts",
      "import": "./dist/extension-sdk/index.js"
    }
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build ./src/cli.ts --outdir ./dist --target bun --external '@opentui/core-*' && bun scripts/build-extension-sdk.ts && bun scripts/build-desktop-sdk.ts",
    "desktop:engine": "bun build src/desktop/entry.ts --compile --outfile dist/chisel-engine",
    "desktop:smoke": "bun tests/fixtures/desktop-server.ts",
    "compile": "bun build ./src/cli.ts --compile --outfile ./dist/chisel",
    "opentui:spike": "bun run scripts/opentui-spike.tsx",
    "opentui:compile": "bun build ./scripts/opentui-spike.tsx --compile --outfile ./dist/opentui-spike",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/test-fast.ts",
    "test:fast": "bun scripts/test-fast.ts",
    "test:full": "bun test",
    "lint": "biome check src tests evals",
    "format": "biome format --write src tests",
    "eval": "bun evals/runner.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/core": "2.3.0",
    "@mozilla/readability": "0.6.0",
    "@opentui/core": "0.5.12",
    "@opentui/react": "0.5.12",
    "acorn": "8.19.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "execa": "10.0.1",
    "fflate": "0.8.2",
    "https-proxy-agent": "9.1.0",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "marked": "17.0.1",
    "openai": "7.13.0",
    "react": "19.3.0",
    "string-width": "8.2.2",
    "tar-stream": "3.1.7",
    "vscode-jsonrpc": "9.0.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@modelcontextprotocol/server": "2.3.0",
    "@types/bun": "1.4.2",
    "@types/diff": "7.0.2",
    "@types/react": "19.3.0",
    "@types/tar-stream": "3.1.4",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAsrada/ChiselCode.git"
  },
  "bugs": {
    "url": "https://github.com/TheAsrada/ChiselCode/issues"
  },
  "homepage": "https://github.com/TheAsrada/ChiselCode#readme",
  "keywords": [
    "agent",
    "cli",
    "coding-agent",
    "llm",
    "bun"
  ]
}
