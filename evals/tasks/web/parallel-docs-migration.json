{
  "mockOnly": true,
  "webFixture": true,
  "fixture": "web-api",
  "timeout": 30,
  "tags": [
    "web",
    "deterministic-fixture",
    "keyless-parallel",
    "research-to-code"
  ],
  "id": "web-parallel-docs-migration",
  "prompt": "The fixture API has changed its public function name. Find the current official documentation, update api.ts to the supported API, and run the project tests. Cite the verified documentation source.",
  "graders": [
    {
      "type": "command",
      "command": "bun test"
    },
    {
      "type": "tool_result",
      "tool": "web_search",
      "untrusted": true
    },
    {
      "type": "tool_result",
      "tool": "web_fetch",
      "untrusted": true
    },
    {
      "type": "tool_result",
      "tool": "read_file"
    },
    {
      "type": "tool_result",
      "tool": "edit_file"
    },
    {
      "type": "tool_result",
      "tool": "run_shell"
    }
  ],
  "constraints": {
    "forbidden_paths": ["api.test.ts", "package.json"]
  },
  "mockTurns": [
    [
      {
        "name": "web_search",
        "input": {
          "query": "Fixture API migration official",
          "domains": ["fixture.docs.example"]
        }
      }
    ],
    [
      {
        "name": "web_fetch",
        "input": {
          "url": "https://fixture.docs.example/article"
        }
      }
    ],
    [
      {
        "name": "read_file",
        "input": {
          "path": "api.ts"
        }
      }
    ],
    [
      {
        "name": "edit_file",
        "input": {
          "path": "api.ts",
          "old_str": "legacyFetch",
          "new_str": "fetchFresh"
        }
      }
    ],
    [
      {
        "name": "run_shell",
        "input": {
          "command": "bun test"
        }
      }
    ]
  ],
  "webSearchBackend": "parallel"
}
